# FF Motors Fleet Management - Environment Variables Configuration
# Copy this file to .env and configure values before running in production

# Security Secret Key for Flask Session Cookies & CSRF Protection
# Generate a secure key with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-very-strong-secret-key-32-chars-min

# Environment mode: 'production' or 'development'
FLASK_ENV=production

# Database Connection:
# For SQLite (local dev): leave DATABASE_URL commented or empty (defaults to ffmotors.db)
# For PostgreSQL (Cloud/Production): postgresql://user:password@localhost:5432/ffmotors
# DATABASE_URL=postgresql://user:password@localhost:5432/ffmotors

# Server Configuration
PORT=5000
HOST=0.0.0.0
